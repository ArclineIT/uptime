# Copy to .env and fill in your values. Never commit the real .env.
# Loaded automatically in development and test via dotenv-rails.

# --- Server ---
# Puma reads PORT (default 3000; the original Go service used 8081).
PORT=8081
# SQLite database file path (absolute or relative to the app root).
DATABASE_PATH=storage/production.sqlite3

# --- Dashboard login (HTTP basic auth) ---
# Required in production. The status page and /metrics are always public.
UPTIME_USERNAME=admin
UPTIME_PASSWORD=

# --- Checks ---
# Seconds between repeat DOWN alerts while a monitor stays down.
UPTIME_ALERT_COOLDOWN=300
# Delete check records older than this many days. 0 keeps them forever.
UPTIME_RETENTION_DAYS=90

# --- SMTP (email alert channels) ---
SMTP_HOST=mail.arclineit.com
SMTP_PORT=587
SMTP_USER=alerts@arclineit.com
SMTP_PASS=
SMTP_FROM=alerts@arclineit.com
