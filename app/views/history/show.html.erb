<% content_for :title, "History — Arcline Uptime" %>

<section class="page-header">
  <div class="container">
    <p class="eyebrow">Uptime</p>
    <h1 class="page-header__title">History</h1>
    <p class="lead">Response time over the last <%= HistoryController::POINTS %> checks. Red dots are failed checks.</p>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <div class="dash">
      <% @sparklines.each do |sparkline| %>
        <section class="dash-section">
          <h2 class="dash-section__title"><%= sparkline.monitor.name %></h2>
          <div class="panel">
            <div class="panel__body">
              <% if sparkline.empty? %>
                <p class="dash-empty">No checks yet.</p>
              <% else %>
                <svg class="sparkline" viewBox="0 0 <%= Sparkline::WIDTH %> <%= Sparkline::HEIGHT %>" preserveAspectRatio="none" role="img"
                     aria-label="Response time for <%= sparkline.monitor.name %>">
                  <polyline class="sparkline__line" points="<%= sparkline.points %>" />
                  <% sparkline.down_xs.each do |x| %>
                    <circle class="sparkline__down" cx="<%= x %>" cy="<%= Sparkline::HEIGHT - Sparkline::PADDING %>" r="3" />
                  <% end %>
                </svg>
                <p class="cell-note"><%= sparkline.count %> checks · avg <%= sparkline.avg_ms.round %> ms · max <%= sparkline.max_ms %> ms · <%= pluralize(sparkline.down_xs.size, "failure") %></p>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
      <% if @sparklines.empty? %><p class="dash-empty">No monitors yet.</p><% end %>
    </div>
  </div>
</section>
