<header class="site-header" data-controller="nav">
  <div class="container site-header__inner">
    <%= link_to root_path, class: "logo", aria: { label: "Arcline Uptime home" } do %>
      <%= render "shared/logo", size: 28 %>
      <span class="logo__word">Arcline</span>
    <% end %>
    <span class="site-header__tag">Uptime</span>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"
            data-nav-target="toggle" data-action="nav#toggle">
      <%= icon :menu, size: 22 %>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="nav" id="site-nav" aria-label="Main" data-nav-target="menu">
      <% unless local_assigns[:public] %>
        <%= link_to "Monitors", root_path, class: "nav__link", aria: { current: ("page" if current_page?(root_path)) } %>
        <%= nav_link "History", history_path %>
        <%= nav_link "Incidents", incidents_path %>
        <%= nav_link "Alerts", alert_channels_path %>
      <% end %>
      <%= nav_link "Status page", status_path %>

      <button class="theme-toggle" type="button" data-controller="theme" data-action="theme#toggle">
        <%= icon :contrast, size: 18 %>
        <span class="theme-toggle__label">Switch theme</span>
      </button>
    </nav>
  </div>
</header>
